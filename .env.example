# Copy to .env (never commit .env). All values have defaults in docker-compose.yml.

# --- Rebrickable ---
# Optional. Used by the backend to map BrickLink-style part IDs to Rebrickable part_num
# when they differ. Get a key at https://rebrickable.com/api/
REBRICKABLE_API_KEY=
# Rebrickable CSV downloads (no key required)
CATALOG_BASE_URL=https://cdn.rebrickable.com/media/downloads
CATALOG_IMPORT_ON_STARTUP=true

# --- Brickognize (inference part classifier) ---
BRICKOGNIZE_URL=https://api.brickognize.com
BRICKOGNIZE_MAX_CONCURRENCY=2

# --- Vision pipeline selection ---
DETECTOR=opencv
PART_CLASSIFIER=brickognize
COLOR_ESTIMATOR=kmeans_lab

# --- Database ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pilescan
DB_USER=pilescan
DB_PASSWORD=pilescan
